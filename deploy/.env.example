# deploy/.env: everything the backend needs (see ../.env.example) plus the deploy-only values.
BACKEND_TAG=latest
NODE_ENV=production
PUBLIC_API_URL=https://api.gezcez.com
OAUTH_UI_URL=https://oauth.gezcez.com
CORS_ORIGINS=https://oauth.gezcez.com,https://dash.gezcez.com
KEY_ENCRYPTION_SECRET=
SEAL_SECRET=
CODE_PEPPER=
CSRF_SECRET=
TURNSTILE_SECRET=
EMAIL_TRANSPORT=ses
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Litestream (R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_BACKUP=gezcez-backup
LITESTREAM_PREFIX=production

# Parquet archive upload (same R2 credentials, its own bucket)
ARCHIVE_UPLOAD=s3
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=gezcez-archive
R2_PREFIX=production/

# cloudflared: cloudflared-credentials.json sits next to this file (never committed)
CLOUDFLARED_CONFIG=cloudflared.yml
