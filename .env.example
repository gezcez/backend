# Copy to .env for local runs. Every variable is validated at boot (src/common/config.ts).
# Empty values count as unset.

# development | test | staging | production
NODE_ENV=development
# api | tracker | all
MODE=all
HOST=0.0.0.0
PORT=8080
# core.db (and later transit.db, vts.db, archive/) live here
DATA_DIR=./data
MIGRATIONS_DIR=./drizzle
# Public base URL of this API; also the token issuer unless ISSUER is set
PUBLIC_API_URL=http://localhost:8080
ISSUER=
# The identity UI (gezcez/oauth)
OAUTH_UI_URL=http://localhost:5174
# Comma separated browser origins. CORS is per route group (src/common/middlewares/cors.ts):
# /v1/account/* and /v1/oauth/authorize*|logout answer OAUTH_UI_URL only, with credentials;
# /v1/oauth/token|revoke send credentials to these origins minus OAUTH_UI_URL (gz_rt, and only
# from the origin of the client's redirect URIs); every other route gets CORS without credentials.
CORS_ORIGINS=http://localhost:5174,http://localhost:5173
# Trust cf-ray / CF-Connecting-IP (only behind the Cloudflare tunnel)
TRUST_CF_HEADERS=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Secrets: 32+ random characters each (openssl rand -base64 32). Required in staging and
# production, and in development whenever PUBLIC_API_URL is not loopback; otherwise development
# and test fall back to an insecure fixed value.
KEY_ENCRYPTION_SECRET=
SEAL_SECRET=
CODE_PEPPER=
CSRF_SECRET=
# Required in staging and production (staging may use Cloudflare's always-pass test secret).
# Empty in development and test: every token passes.
TURNSTILE_SECRET=
# Staging only: fixed email code for *@test.gezcez.com (refused with NODE_ENV=production and on
# the api.gezcez.com host)
STAGING_TEST_OTP=

STEP_UP_MAX_AGE_S=600
REFRESH_GRACE_S=10
# Multiplies every rate limit (1 in production)
RATE_LIMIT_SCALE=1

# ses | console | memory. Staging and production require ses (and SES_REGION); memory only with
# NODE_ENV=test. Empty: memory under NODE_ENV=test (feeds GET /v1/__test/mailbox), console in
# development (bodies with codes go to stderr, never to the logger).
EMAIL_TRANSPORT=
EMAIL_FROM=gezcez <noreply@gezcez.com>
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

SENTRY_DSN=
SENTRY_ENVIRONMENT=
METRICS_TOKEN=
ALERT_WEBHOOK_URL=

# ---- transit providers and tracker ----
# Kentkart credentials (never commit real values). Without them the Kentkart realm reports
# "missing" and its bindings go down; set PROVIDER_REPLAY=kentkart to run on synthetic data.
KENTKART_CLIENT_ID=
KENTKART_CLIENT_SECRET=
KENTKART_REFRESH_TOKEN=
# Env hard kill per provider (true/false, needs a restart)
PROVIDER_KENTKART_ENABLED=true
PROVIDER_FAKE_ENABLED=true
# Comma separated provider keys served by the fake provider instead (local runs)
PROVIDER_REPLAY=
# worker (Bun Worker next to the API) | inline (same thread) | manual (no timers, tests) | off
TRACKER_RUNNER=worker
# Upstream requests in flight per process
UPSTREAM_MAX_IN_FLIGHT=4
# Local quiet hours with 5 min polling unless vehicles were seen ("off" to disable)
TRACKER_QUIET_HOURS=01:30-05:00
# Days of positions kept in vts.db
VTS_HOT_DAYS=7
# Delete only days whose Parquet archive is verified (keep true once the archive job runs)
VTS_RETENTION_REQUIRE_ARCHIVE=true
# Daily static sync (local time) or "off"
TRANSIT_SYNC_AT=04:00
