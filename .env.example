# Copy to .env for local runs. Every variable is validated at boot (src/common/config.ts).
# Empty values count as unset.

# development | test | staging | production
NODE_ENV=development
# api | tracker | all
MODE=all
HOST=0.0.0.0
PORT=8080
# core.db (and later transit.db, vts.db, archive/) live here
DATA_DIR=./data
MIGRATIONS_DIR=./drizzle
# Public base URL of this API; also the token issuer unless ISSUER is set
PUBLIC_API_URL=http://localhost:8080
ISSUER=
# The identity UI (gezcez/oauth)
OAUTH_UI_URL=http://localhost:5174
# MapLibre styles the app gets from /v1/app/config (defaults: tiles.gezcez.com; OpenFreeMap
# https://tiles.openfreemap.org/styles/liberty is the fallback while tiles are not live)
TILES_STYLE_URL_LIGHT=
TILES_STYLE_URL_DARK=
# Comma separated browser origins allowed with credentials (oauth UI, dashboard)
CORS_ORIGINS=http://localhost:5174,http://localhost:5173
# Trust cf-ray / CF-Connecting-IP (only behind the Cloudflare tunnel)
TRUST_CF_HEADERS=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Secrets: 32+ random characters each (openssl rand -base64 32). Required in staging and
# production; development and test fall back to an insecure fixed value.
KEY_ENCRYPTION_SECRET=
SEAL_SECRET=
CODE_PEPPER=
CSRF_SECRET=
TURNSTILE_SECRET=
# Staging only: fixed email code for *@test.gezcez.com (refused on the production API)
STAGING_TEST_OTP=

STEP_UP_MAX_AGE_S=600
# Passkeys: relying party id (gezcez.com in staging and production) and the origins allowed
# in WebAuthn client data (default: OAUTH_UI_URL)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=gezcez
WEBAUTHN_ORIGINS=
REFRESH_GRACE_S=10
# Multiplies every rate limit (1 in production)
RATE_LIMIT_SCALE=1

# ses | console | memory (memory only with NODE_ENV=test).
# Empty: memory under NODE_ENV=test (feeds GET /v1/__test/mailbox), console elsewhere.
EMAIL_TRANSPORT=
EMAIL_FROM=gezcez <noreply@gezcez.com>
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

SENTRY_DSN=
SENTRY_ENVIRONMENT=
METRICS_TOKEN=
ALERT_WEBHOOK_URL=

# ---- transit providers and tracker ----
# Kentkart credentials (never commit real values). Without them the Kentkart realm reports
# "missing" and its bindings go down; set PROVIDER_REPLAY=kentkart to run on synthetic data.
KENTKART_CLIENT_ID=
KENTKART_CLIENT_SECRET=
KENTKART_REFRESH_TOKEN=
# Env hard kill per provider (true/false, needs a restart)
PROVIDER_KENTKART_ENABLED=true
PROVIDER_FAKE_ENABLED=true
# Comma separated provider keys served by the fake provider instead (local runs)
PROVIDER_REPLAY=
# worker (Bun Worker next to the API) | inline (same thread) | manual (no timers, tests) | off
TRACKER_RUNNER=worker
# Upstream requests in flight per process
UPSTREAM_MAX_IN_FLIGHT=4
# Local quiet hours with 5 min polling unless vehicles were seen ("off" to disable)
TRACKER_QUIET_HOURS=01:30-05:00
# Days of positions kept in vts.db
VTS_HOT_DAYS=7
# Delete only days whose Parquet archive is verified (keep true once the archive job runs)
VTS_RETENTION_REQUIRE_ARCHIVE=true
# Daily static sync (local time) or "off"
TRANSIT_SYNC_AT=04:00

# ---- archive and analytics ----
# Daily Parquet export of the previous UTC date (local time) or "off"
ARCHIVE_EXPORT_AT=03:30
# Nightly aggregates under data/agg (local time) or "off"
AGGREGATES_AT=04:30
# Days of uploaded Parquet partitions kept on local disk
ARCHIVE_LOCAL_DAYS=90
# none (local only) | local (copy to ARCHIVE_MIRROR_DIR) | s3 (Cloudflare R2)
ARCHIVE_UPLOAD=none
ARCHIVE_MIRROR_DIR=
# R2 (S3 API), required when ARCHIVE_UPLOAD=s3
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Key prefix inside the bucket, e.g. "archive/" (keys mirror data/archive)
R2_PREFIX=
# DuckDB (in-process analytics)
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_EXTENSION_DIR=
ANALYTICS_TIMEOUT_MS=10000
ANALYTICS_MAX_CONCURRENT=2
