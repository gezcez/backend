{
	"name": "gezcez-backend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "gezcez API: OAuth authorization server, dashboard, mobile and public transit API",
	"scripts": {
		"dev": "bun --watch src/main.ts",
		"start": "bun dist/main.js",
		"build": "bun build src/main.ts --target=bun --outdir=dist --packages=external --sourcemap=linked",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun run test:unit && bun run test:e2e",
		"test:unit": "bun test src eslint-rules",
		"test:e2e": "bun test ./test/e2e/*.e2e.ts",
		"db:generate": "drizzle-kit generate --config drizzle.core.config.ts",
		"db:check": "drizzle-kit check --config drizzle.core.config.ts",
		"db:migrate": "bun scripts/migrate.ts",
		"db:seed": "bun scripts/seed.ts",
		"openapi:export": "bun scripts/export-openapi.ts",
		"openapi:check": "bun scripts/export-openapi.ts --check",
		"keys:rotate": "bun scripts/rotate-keys.ts"
	},
	"dependencies": {
		"@aws-sdk/client-sesv2": "^3.1155.0",
		"@nestjs/common": "^11.2.7",
		"@nestjs/core": "^11.2.7",
		"@nestjs/platform-express": "^11.2.7",
		"@nestjs/swagger": "^11.4.7",
		"@nestjs/throttler": "^6.7.1",
		"@scalar/nestjs-api-reference": "^1.2.30",
		"cookie-parser": "^1.4.7",
		"drizzle-orm": "^0.45.4",
		"jose": "^6.2.13",
		"nestjs-pino": "^5.3.1",
		"nestjs-zod": "^5.5.0",
		"pino": "^10.4.0",
		"pino-http": "^11.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"ulid": "^3.0.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@nestjs/testing": "^11.2.7",
		"@types/bun": "^1.4.3",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.39.5",
		"prettier": "^3.9.10",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.72.0"
	}
}
