{
	"components": {
		"schemas": {
			"ApiError": {
				"additionalProperties": false,
				"properties": {
					"code": {
						"$ref": "#/components/schemas/ErrorCode"
					},
					"details": {
						"additionalProperties": {},
						"propertyNames": {
							"type": "string"
						},
						"type": "object"
					},
					"message": {
						"type": "string"
					},
					"request_id": {
						"type": "string"
					}
				},
				"required": [
					"code",
					"message",
					"request_id"
				],
				"type": "object"
			},
			"ErrorCode": {
				"enum": [
					"VALIDATION_FAILED",
					"AUTH_REQUIRED",
					"AUTH_SESSION_REQUIRED",
					"AUTH_TOKEN_INVALID",
					"AUTH_TOKEN_EXPIRED",
					"AUTH_SESSION_REVOKED",
					"AUTH_CODE_INVALID",
					"AUTH_CODE_EXPIRED",
					"AUTH_CODE_ATTEMPTS",
					"AUTH_PASSWORD_INVALID",
					"AUTH_PASSWORD_WEAK",
					"AUTH_PASSWORD_BREACHED",
					"AUTH_TURNSTILE_FAILED",
					"AUTH_STEP_UP_REQUIRED",
					"CSRF_INVALID",
					"OAUTH_INVALID_CLIENT",
					"OAUTH_INVALID_REDIRECT_URI",
					"OAUTH_REQUEST_EXPIRED",
					"OAUTH_REQUEST_NOT_FOUND",
					"SCOPE_MISSING",
					"PERMISSION_MISSING",
					"ROLE_LEVEL_TOO_LOW",
					"ROLE_IMMUTABLE",
					"USER_BANNED",
					"USER_PENDING_DELETION",
					"USER_DELETED",
					"EMAIL_TAKEN",
					"USERNAME_TAKEN",
					"NOT_FOUND",
					"CONFLICT",
					"VERSION_CONFLICT",
					"RATE_LIMITED",
					"PROVIDER_DISABLED",
					"PROVIDER_UNAVAILABLE",
					"CAPABILITY_UNSUPPORTED",
					"CARD_NOT_FOUND",
					"ANALYTICS_TIMEOUT",
					"INTERNAL"
				],
				"type": "string"
			},
			"ErrorResponse": {
				"properties": {
					"error": {
						"$ref": "#/components/schemas/ApiError"
					},
					"ok": {
						"enum": [
							false
						],
						"type": "boolean"
					}
				},
				"required": [
					"ok",
					"error"
				],
				"type": "object"
			},
			"HealthDto": {
				"properties": {
					"status": {
						"const": "ok",
						"type": "string"
					}
				},
				"required": [
					"status"
				],
				"type": "object"
			},
			"ReadyDto": {
				"properties": {
					"checks": {
						"items": {
							"properties": {
								"name": {
									"type": "string"
								},
								"ok": {
									"type": "boolean"
								}
							},
							"required": [
								"name",
								"ok"
							],
							"type": "object"
						},
						"type": "array"
					},
					"ready": {
						"type": "boolean"
					}
				},
				"required": [
					"ready",
					"checks"
				],
				"type": "object"
			},
			"VersionDto": {
				"properties": {
					"build_time": {
						"items": {
							"type": "string"
						},
						"type": "array"
					},
					"env": {
						"type": "string"
					},
					"git_sha": {
						"type": "string"
					},
					"mode": {
						"enum": [
							"api",
							"tracker",
							"all"
						],
						"type": "string"
					},
					"uptime_s": {
						"maximum": 9007199254740991,
						"minimum": -9007199254740991,
						"type": "integer"
					},
					"version": {
						"type": "string"
					}
				},
				"required": [
					"version",
					"git_sha",
					"build_time",
					"mode",
					"env",
					"uptime_s"
				],
				"type": "object"
			}
		},
		"securitySchemes": {
			"bearer": {
				"bearerFormat": "JWT",
				"scheme": "bearer",
				"type": "http"
			},
			"session": {
				"in": "cookie",
				"name": "__Host-gz_session",
				"type": "apiKey"
			}
		}
	},
	"info": {
		"contact": {},
		"description": "OAuth authorization server, dashboard, mobile and public transit API for gezcez. Every response except /v1/oauth/token, /v1/oauth/revoke, /.well-known/*, /health and /ready is wrapped in `{ ok, data }` or `{ ok: false, error }`.",
		"title": "gezcez API",
		"version": "0.1.0"
	},
	"openapi": "3.1.0",
	"paths": {
		"/health": {
			"get": {
				"operationId": "System_health",
				"parameters": [],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HealthDto"
								}
							}
						},
						"description": "Success"
					},
					"default": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						},
						"description": "Error envelope"
					}
				},
				"tags": [
					"system"
				]
			}
		},
		"/ready": {
			"get": {
				"operationId": "System_ready",
				"parameters": [],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ReadyDto"
								}
							}
						},
						"description": "503 when any check fails"
					},
					"default": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						},
						"description": "Error envelope"
					}
				},
				"tags": [
					"system"
				]
			}
		},
		"/v1/system/version": {
			"get": {
				"operationId": "System_version",
				"parameters": [],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"properties": {
										"data": {
											"$ref": "#/components/schemas/VersionDto"
										},
										"ok": {
											"enum": [
												true
											],
											"type": "boolean"
										}
									},
									"required": [
										"ok",
										"data"
									],
									"type": "object"
								}
							}
						},
						"description": "Success"
					},
					"default": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/ErrorResponse"
								}
							}
						},
						"description": "Error envelope"
					}
				},
				"tags": [
					"system"
				]
			}
		}
	},
	"servers": [
		{
			"url": "https://api.gezcez.com"
		}
	],
	"tags": []
}
